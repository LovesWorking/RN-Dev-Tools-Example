{
  "name": "@rn-dev-tools/react-native-network-inspector",
  "version": "0.1.0",
  "description": "React Native network monitoring and inspection tools",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "network",
    "monitoring",
    "debugging",
    "inspector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/rn-dev-tools.git",
    "directory": "packages/react-native-network-inspector"
  },
  "author": "Your Organization",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/rn-dev-tools/issues"
  },
  "homepage": "https://github.com/your-org/rn-dev-tools/tree/main/packages/react-native-network-inspector#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@react-native/typescript-config": "^0.75.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react-native": "0.75.0",
    "react-native-builder-bob": "^0.30.2",
    "typescript": "^5.0.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}